{
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(npx prisma generate)",
      "Bash(npx dotenv:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(netstat:*)",
      "Bash(findstr:*)",
      "Bash(npx next build)",
      "Bash(npm run build:*)",
      "Bash(npm run lint:*)",
      "Bash(npm test:*)",
      "Bash(npx vitest:*)",
      "Bash(npx playwright:*)",
      "Bash(npx prisma migrate:*)",
      "Bash(npx prisma db push:*)",
      "Bash(npx prisma:*)",
      "Bash(npx tsc:*)",
      "Bash(npx depcheck --json)",
      "Bash(npm uninstall:*)",
      "Bash(npm install:*)",
      "Bash(npx eslint:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(tasklist:*)",
      "Bash(.claude\\hooks\\stop-hook.bat)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/*secret*)",
      "Read(**/*credential*)",
      "Read(**/*private_key*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude\\hooks\\stop-hook.bat"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -Command \"[System.Reflection.Assembly]::LoadWithPartialName('System.Windows.Forms'); [System.Windows.Forms.MessageBox]::Show('Claude Code needs attention','VakSpot Agent')\" 2>$null || true"
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  }
}
