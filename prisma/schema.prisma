// prisma/schema.prisma
// VakSpot Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// AUTH & USERS
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String?
  role          Role      @default(CLIENT)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Email notification preferences
  emailNewMessages  Boolean @default(true)  // New chat messages
  emailNewInterest  Boolean @default(true)  // PRO shows interest (for clients)
  emailBidUpdates   Boolean @default(true)  // Bid accepted/rejected (for PROs)
  emailNewJobs      Boolean @default(true)  // New jobs in area (for PROs)
  emailMarketing    Boolean @default(false) // Marketing & promotions
  emailWeeklyDigest Boolean @default(false) // Weekly summary
  emailJobUpdates   Boolean @default(true)  // Job status updates (for clients)

  // Privacy settings (GDPR)
  profileVisible     Boolean @default(true)  // Profile visible to others (PROs only)
  chatRetentionDays  Int     @default(730)   // Chat retention period (default 2 years = 730 days)

  // Suspension (P2B compliance)
  suspended        Boolean   @default(false)
  suspendedAt      DateTime?
  suspensionReason String?   @db.Text
  suspendedBy      String?   // Admin user ID who suspended

  // Profiles (one-to-one)
  clientProfile ClientProfile?
  proProfile    ProProfile?

  // Sessions & Accounts for NextAuth
  accounts Account[]
  sessions Session[]

  // Messages sent
  messages Message[]

  // Reports filed by this user
  reports Report[]

  @@index([email])
  @@index([role])
  @@index([suspended])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  CLIENT
  PRO
  ADMIN
}

enum EntityType {
  BUSINESS   // Registered business (e.g., BV, VOF)
  INDIVIDUAL // Sole proprietor / ZZP'er
}

// ============================================
// PROFILES
// ============================================

model ClientProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String?
  address   String?
  city      String?
  postcode  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Jobs posted by this client
  jobs Job[]
}

model ProProfile {
  id            String     @id @default(cuid())
  userId        String     @unique
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName   String
  kvkNumber     String?    // Chamber of Commerce number
  entityType    EntityType @default(INDIVIDUAL) // Business or individual (ZZP'er)
  description   String?    @db.Text
  phone         String
  website       String?
  serviceRadius    Int      @default(25) // km
  locationLat      Float?
  locationLng      Float?
  locationCity     String?
  locationPostcode String?
  verified      Boolean  @default(false)
  active        Boolean  @default(true)
  
  // Aggregated stats (denormalized for performance)
  avgRating     Float    @default(0)
  totalReviews  Int      @default(0)
  responseRate  Float    @default(100) // percentage
  responseTime  Int?     // average response time in hours

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  categories       ProCategory[]
  bids             Bid[]
  reviews          Review[]
  servicePurchases ServicePurchase[]

  @@index([locationLat, locationLng])
  @@index([avgRating])
  @@index([verified])
}

// ============================================
// CATEGORIES
// ============================================

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?  // Lucide icon name
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  pros ProCategory[]
  jobs Job[]

  @@index([slug])
  @@index([active, order])
}

model ProCategory {
  proId      String
  categoryId String
  yearsExp   Int?       // Years of experience in this category
  pro        ProProfile @relation(fields: [proId], references: [id], onDelete: Cascade)
  category   Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([proId, categoryId])
}

// ============================================
// JOBS
// ============================================

model Job {
  id          String    @id @default(cuid())
  title       String
  description String    @db.Text
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
  clientId    String
  client      ClientProfile @relation(fields: [clientId], references: [id])
  
  status      JobStatus @default(DRAFT)
  
  // Budget
  budgetMin   Int?      // in cents
  budgetMax   Int?      // in cents
  budgetType  BudgetType @default(ESTIMATE)
  
  // Location
  locationAddress  String?
  locationCity     String
  locationPostcode String
  locationLat      Float?
  locationLng      Float?
  
  // Timeline
  timeline    Timeline  @default(FLEXIBLE)
  startDate   DateTime?  // Desired start date from client

  // Status Tracking (Phase 7)
  startedAt           DateTime?        // Actual work start timestamp
  completedAtByPro    DateTime?        // When PRO marked complete
  completedAtByCons   DateTime?        // When consumer marked complete
  cancelledAt         DateTime?        // When cancelled
  cancellationReason  String?   @db.Text  // Required for PRO cancellation (min 10 chars)
  statusChangedBy     StatusChangedBy? // Who made the last status change
  statusChangedAt     DateTime?        // When status last changed

  // Metadata
  viewCount   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  completedAt DateTime?  // Legacy field for backwards compatibility

  // Sponsored placement
  sponsoredUntil DateTime?
  sponsorLevel   Int       @default(0) // 0=none, 1=basic, 2=premium

  // Relations
  images        JobImage[]
  bids          Bid[]
  review        Review?
  statusHistory StatusHistory[]

  // Accepted bid (one-to-one)
  acceptedBidId String? @unique
  acceptedBid   Bid?    @relation("AcceptedBid", fields: [acceptedBidId], references: [id])

  @@index([status])
  @@index([categoryId])
  @@index([clientId])
  @@index([locationLat, locationLng])
  @@index([createdAt])
}

model JobImage {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  url       String
  filename  String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([jobId])
}

// Status History (Audit Trail for Phase 7)
model StatusHistory {
  id          String          @id @default(cuid())
  jobId       String
  job         Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  fromStatus  JobStatus
  toStatus    JobStatus
  changedBy   StatusChangedBy
  changedAt   DateTime        @default(now())
  reason      String?         @db.Text  // Optional reason for the change
  userId      String?         // Who triggered the change (null for SYSTEM)

  @@index([jobId])
  @@index([changedAt])
}

enum JobStatus {
  // Phase 1: Job Creation & Visibility
  CREATED           // Was DRAFT - job created, visible to PROs
  FLAGGED           // Reported via DSA, under review

  // Phase 2: PRO Interest & Communication
  RESPONSES_RECEIVED // At least one PRO showed interest
  IN_CONVERSATION   // Messages exchanged between client and PRO
  QUOTE_RECEIVED    // PRO sent a formal quote

  // Phase 3: Selection & Scheduling
  SELECTED          // Was ACCEPTED - Client chose a PRO ("Nader te bepalen")
  SCHEDULED         // PRO set a start date
  IN_PROGRESS       // Work has started

  // Phase 4: Completion
  COMPLETED_BY_CONSUMER // Client marked as complete
  COMPLETED_BY_PRO      // PRO marked as complete
  REVIEWED              // Client left a review

  // Cancellation & Expiry
  CANCELLED_BY_CONSUMER // Client cancelled
  CANCELLED_BY_PRO      // PRO cancelled (reason required)
  NO_MATCH              // No responses after timeout
  EXPIRED               // Job inactive/expired

  // Legacy (for migration compatibility)
  DRAFT      @map("DRAFT")
  PUBLISHED  @map("PUBLISHED")
  ACCEPTED   @map("ACCEPTED")
  COMPLETED  @map("COMPLETED")
}

enum StatusChangedBy {
  CONSUMER
  PROFESSIONAL
  SYSTEM
  ADMIN
}

enum BudgetType {
  FIXED
  ESTIMATE
  HOURLY
  TO_DISCUSS
}

enum Timeline {
  URGENT      // Within a few days
  THIS_WEEK
  THIS_MONTH
  NEXT_MONTH
  FLEXIBLE
}

// ============================================
// BIDS
// ============================================

model Bid {
  id          String    @id @default(cuid())
  jobId       String
  job         Job       @relation(fields: [jobId], references: [id])
  proId       String
  pro         ProProfile @relation(fields: [proId], references: [id])
  
  amount      Int       // in cents
  amountType  BudgetType @default(ESTIMATE)
  message     String    @db.Text
  status      BidStatus @default(PENDING)
  
  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  viewedAt    DateTime?
  
  // Relations
  acceptedJob  Job?      @relation("AcceptedBid")
  conversation Conversation?
  quotes       Quote[]   // Phase 7: PRO can send formal quotes

  @@unique([jobId, proId]) // One bid per pro per job
  @@index([jobId])
  @@index([proId])
  @@index([status])
}

enum BidStatus {
  PENDING
  VIEWED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

// ============================================
// QUOTES (Phase 7)
// ============================================

model Quote {
  id           String      @id @default(cuid())
  bidId        String
  bid          Bid         @relation(fields: [bidId], references: [id], onDelete: Cascade)

  // Quote details
  amount       Int         // in cents
  amountType   BudgetType  @default(ESTIMATE)
  description  String      @db.Text
  validUntil   DateTime    // Quote expiration date

  // Status
  status       QuoteStatus @default(PENDING)

  // Timestamps
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  acceptedAt   DateTime?
  rejectedAt   DateTime?

  @@index([bidId])
  @@index([status])
  @@index([validUntil])
}

enum QuoteStatus {
  PENDING    // Waiting for consumer response
  ACCEPTED   // Consumer accepted
  REJECTED   // Consumer rejected
  EXPIRED    // Past validUntil date
  WITHDRAWN  // PRO withdrew the quote
}

// ============================================
// MESSAGING
// ============================================

model Conversation {
  id        String    @id @default(cuid())
  bidId     String    @unique
  bid       Bid       @relation(fields: [bidId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  messages Message[]

  @@index([updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  content        String       @db.Text
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())

  // Attachments
  attachments    MessageAttachment[]

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

model MessageAttachment {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  url       String
  filename  String
  fileType  String   // mime type
  fileSize  Int      // bytes
  createdAt DateTime @default(now())

  @@index([messageId])
}

// ============================================
// REVIEWS
// ============================================

model Review {
  id        String     @id @default(cuid())
  jobId     String     @unique
  job       Job        @relation(fields: [jobId], references: [id])
  proId     String
  pro       ProProfile @relation(fields: [proId], references: [id])
  
  rating    Int        // 1-5
  title     String?
  content   String     @db.Text

  // Pro can respond
  response    String?  @db.Text
  respondedAt DateTime?
  
  // Moderation
  verified  Boolean  @default(false)
  flagged   Boolean  @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([proId])
  @@index([rating])
  @@index([createdAt])
}

// ============================================
// NOTIFICATIONS (for future use)
// ============================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([createdAt])
}

enum NotificationType {
  NEW_LEAD
  NEW_BID
  BID_ACCEPTED
  BID_REJECTED
  NEW_MESSAGE
  REVIEW_REQUEST
  REVIEW_RECEIVED
  SYSTEM
}

// ============================================
// SERVICES (for PRO monetization)
// ============================================

model Service {
  id           String   @id @default(cuid())
  name         String
  description  String   @db.Text
  price        Int      @default(0) // cents, 0 for free
  durationDays Int      @default(30)
  active       Boolean  @default(true)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  purchases ServicePurchase[]

  @@index([active, order])
}

model ServicePurchase {
  id                    String     @id @default(cuid())
  proId                 String
  pro                   ProProfile @relation(fields: [proId], references: [id], onDelete: Cascade)
  serviceId             String
  service               Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  price                 Int        // price at time of purchase (cents)
  purchasedAt           DateTime   @default(now())
  expiresAt             DateTime
  stripeSessionId       String?    // Stripe Checkout session ID
  stripePaymentIntentId String?    // Stripe Payment Intent ID

  @@index([proId])
  @@index([serviceId])
  @@index([expiresAt])
  @@index([stripeSessionId])
}

// ============================================
// REPORTS (DSA Compliance)
// ============================================

model Report {
  id          String       @id @default(cuid())
  type        ReportType
  targetId    String       // ID of reported job, profile, or message
  reporterId  String
  reporter    User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason      ReportReason
  description String?      @db.Text
  status      ReportStatus @default(OPEN)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Resolution
  resolvedAt  DateTime?
  resolvedBy  String?      // Admin user ID
  resolution  String?      @db.Text

  @@index([type, targetId])
  @@index([reporterId])
  @@index([status])
  @@index([createdAt])
}

enum ReportType {
  JOB
  PROFILE
  MESSAGE
}

enum ReportReason {
  SPAM
  FRAUD
  INAPPROPRIATE
  ILLEGAL
  HARASSMENT
  OTHER
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

// ============================================
// APPEALS (P2B Compliance)
// ============================================

model Appeal {
  id          String       @id @default(cuid())
  userId      String
  type        AppealType
  reason      String       @db.Text
  status      AppealStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Resolution
  resolvedAt  DateTime?
  resolvedBy  String?      // Admin user ID
  resolution  String?      @db.Text

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

enum AppealType {
  SUSPENSION
  REPORT_DECISION
  CONTENT_REMOVAL
}

enum AppealStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

// ============================================
// MODERATION LOG (Audit Trail)
// ============================================

model ModerationLog {
  id          String         @id @default(cuid())
  adminId     String
  action      ModerationAction
  targetType  String         // "user", "job", "review", "report"
  targetId    String
  reason      String?        @db.Text
  details     String?        @db.Text // JSON with additional details
  createdAt   DateTime       @default(now())

  @@index([adminId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

enum ModerationAction {
  SUSPEND_USER
  UNSUSPEND_USER
  DELETE_CONTENT
  HIDE_CONTENT
  RESOLVE_REPORT
  DISMISS_REPORT
  APPROVE_APPEAL
  REJECT_APPEAL
  VERIFY_PRO
  UNVERIFY_PRO
}
